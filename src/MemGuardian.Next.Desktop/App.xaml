<Application x:Class="MemGuardian.Next.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="Ink" Color="#E7F2FF" />
    <SolidColorBrush x:Key="Muted" Color="#91A8BF" />
    <SolidColorBrush x:Key="Accent" Color="#36E2D0" />
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#27DCCB" Offset="0" />
      <GradientStop Color="#568BFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AccentSoft" Color="#153342" />
    <LinearGradientBrush x:Key="Canvas" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#07111E" Offset="0" />
      <GradientStop Color="#0B1727" Offset="0.55" />
      <GradientStop Color="#101D2E" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Card" Color="#101E2E" />
    <SolidColorBrush x:Key="Line" Color="#23394F" />
    <SolidColorBrush x:Key="Sidebar" Color="#07111D" />
    <SolidColorBrush x:Key="SidebarMuted" Color="#A9BCD0" />
    <SolidColorBrush x:Key="Success" Color="#42E3A5" />
    <SolidColorBrush x:Key="Warning" Color="#FFB85E" />
    <SolidColorBrush x:Key="Danger" Color="#FF657D" />
    <Style x:Key="ScrollbarPageButton" TargetType="{x:Type RepeatButton}">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type RepeatButton}">
            <Border Background="Transparent" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <Grid Background="Transparent" SnapsToDevicePixels="True">
              <Border x:Name="ScrollbarRail" Margin="2" Background="#0C1826" CornerRadius="5" />
              <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton x:Name="PART_DecreaseButton" Style="{StaticResource ScrollbarPageButton}" Command="{x:Static ScrollBar.PageUpCommand}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb x:Name="PART_Thumb" MinHeight="42" Margin="2,3">
                    <Thumb.Template>
                      <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbSurface" Background="#344B63" BorderBrush="#405C76" BorderThickness="1" CornerRadius="4" />
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbSurface" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="ThumbSurface" Property="BorderBrush" Value="#71F2E4" />
                          </Trigger>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbSurface" Property="Background" Value="{StaticResource AccentGradient}" />
                            <Setter TargetName="ThumbSurface" Property="BorderBrush" Value="#80FFF1" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton x:Name="PART_IncreaseButton" Style="{StaticResource ScrollbarPageButton}" Command="{x:Static ScrollBar.PageDownCommand}" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="10" />
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                <Setter TargetName="PART_Thumb" Property="MinHeight" Value="0" />
                <Setter TargetName="PART_Thumb" Property="MinWidth" Value="42" />
                <Setter TargetName="PART_Thumb" Property="Margin" Value="3,2" />
                <Setter TargetName="PART_DecreaseButton" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}" />
                <Setter TargetName="PART_IncreaseButton" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ScrollbarRail" Property="Background" Value="#14253A" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto" />
          <Setter Property="Height" Value="10" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="{StaticResource AccentGradient}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="1" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.62" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Foreground" Value="#C3D4E6" />
      <Setter Property="Background" Value="#15263A" />
      <Setter Property="BorderBrush" Value="#2A4057" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="WindowButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#9FB3C8" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ChromeButton" Background="{TemplateBinding Background}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChromeButton" Property="Background" Value="#1C3045" /></Trigger>
              <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" Value="Close">
                <Setter TargetName="ChromeButton" Property="Background" Value="Transparent" />
              </DataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsMouseOver}" Value="True" />
                  <Condition Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" Value="Close" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="ChromeButton" Property="Background" Value="#C9475F" />
                <Setter Property="Foreground" Value="White" />
              </MultiDataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource SidebarMuted}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="Margin" Value="0,1,0,5" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="NavBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#22364B" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#2B4663" /></Trigger>
              <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" Value="selected">
                <Setter TargetName="NavBorder" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="NavBorder" Property="BorderThickness" Value="3,0,0,0" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FieldBox" TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Background" Value="#0C1929" />
      <Setter Property="BorderBrush" Value="#2A4057" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="11,9" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputBorder" Property="Opacity" Value="0.5" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CustomCheckBox" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border x:Name="CheckTrack" Width="42" Height="24" CornerRadius="12" Background="#294057" VerticalAlignment="Center">
                <Ellipse x:Name="CheckThumb" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3" />
              </Border>
              <ContentPresenter Margin="11,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckTrack" Property="Background" Value="{StaticResource Accent}" />
                <Setter TargetName="CheckThumb" Property="HorizontalAlignment" Value="Right" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckTrack" Property="Opacity" Value="0.86" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="CheckTrack" Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
